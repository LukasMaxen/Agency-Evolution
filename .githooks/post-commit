#!/bin/bash
# Auto-sync: push to GitHub automatically after every commit

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "main")

echo "🚀 Auto-pushing to GitHub..."

git push origin "$BRANCH"

if [ $? -eq 0 ]; then
  echo "✅ Successfully pushed to GitHub. Team members can now pull your changes."
else
  echo ""
  echo "❌ Auto-push failed. You may need to pull first:"
  echo "   git pull --rebase origin $BRANCH"
  echo "   Then push again with: git push origin $BRANCH"
fi
