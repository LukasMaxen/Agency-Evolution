# Copy this file to .env.local and ask Lukas for the secret values.
# .env.local is gitignored — never commit real secrets.

# PostgreSQL connection string for the Hetzner instance.
# ssl: false (handled in lib/db.ts).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/ai_reply_desk

# Claude Haiku API key used by /api/analyze for reply classification.
ANTHROPIC_API_KEY=sk-ant-...

# Calendly OAuth token used for slot fetching and meeting booking.
CALENDLY_TOKEN=...

# Base URL for the shared EmailBison instance.
EMAILBISON_BASE_URL=https://send.emailagencyevolution.com

# Airtable personal access token. Used by the CSM update skill to look up
# Meeting Booked Date per client base. Read-only access is sufficient.
AIRTABLE_API_KEY=pat...

# Slack bot token and workspace IDs (for outbound Slack posts).
SLACK_BOT_TOKEN=xoxb-...
SLACK_TEAM_ID=T...
SLACK_VENTURE_EXITS_MEETINGS_CHANNEL_ID=C...

# Fathom Analytics API key.
FATHOM_API_KEY=...

# Shared secret for the webhook -> /api/auto-reply/run self-fetch trigger.
# Any random string; must match between this app's env and itself. If unset,
# /api/auto-reply/run returns 500 and replies never get processed.
AUTO_REPLY_RUN_TOKEN=...

# Calendly API tokens per client. Used by auto-reply to fetch available slots
# and suggest times in replies. Add one per client that uses Calendly.
ACCELER8RS_CALENDLY_TOKEN=...
